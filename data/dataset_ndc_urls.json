{
  "dataset_sources": {
    "UNFCCC_NDC_Registry": {
      "description": "Official UNFCCC NDC Registry — browse and download all countries' NDC documents",
      "url": "https://unfccc.int/NDCREG",
      "used_in": ["RQ1", "RQ2", "RQ3", "RQ4", "RQ5"]
    },
    "ClimateBERT_climate_specificity": {
      "description": "HuggingFace dataset — labelled climate policy sentences (SPECIFIC/VAGUE)",
      "url": "https://huggingface.co/datasets/climatebert/climate_specificity",
      "load_code": "load_dataset('climatebert/climate_specificity')",
      "used_in": ["RQ1"]
    },
    "ClimateBERT_environmental_claims": {
      "description": "HuggingFace dataset — labelled environmental claims for greenwashing scoring reference",
      "url": "https://huggingface.co/datasets/climatebert/environmental_claims",
      "load_code": "load_dataset('climatebert/environmental_claims')",
      "used_in": ["RQ4"]
    },
    "ClimatePolicyRadar_national_climate_targets": {
      "description": "ClimatePolicyRadar — national climate targets dataset for RQ3 commitment extraction few-shots",
      "url": "https://huggingface.co/datasets/ClimatePolicyRadar/national-climate-targets",
      "load_code": "load_dataset('ClimatePolicyRadar/national-climate-targets')",
      "used_in": ["RQ3"]
    },
    "IGES_NDC_Database": {
      "description": "Institute for Global Environmental Strategies NDC Database — country metadata and NDC round tracking",
      "url": "https://www.iges.or.jp/en/pub/iges-ndc-database/en",
      "used_in": ["RQ2"]
    },
    "Climate_Watch_NDC_Data": {
      "description": "Climate Watch — cross-reference for time-bound commitment years across NDC rounds",
      "url": "https://www.climatewatchdata.org/ndcs",
      "used_in": ["RQ3"]
    },
    "IEA_Emissions_Data": {
      "description": "International Energy Agency — verified emissions reduction figures by country",
      "url": "https://www.iea.org/data-and-statistics",
      "used_in": ["RQ4"]
    },
    "World_Bank_GDP": {
      "description": "World Bank GDP per capita data — used for Spearman rho vs GDP correlation analysis",
      "url": "https://data.worldbank.org/indicator/NY.GDP.MKTP.CD",
      "used_in": ["RQ5"]
    }
  },
